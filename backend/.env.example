# CP Club Backend — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit the real .env file.

# ── Database (MySQL via XAMPP) ────────────────────────────────────────────────
# XAMPP default: root with no password on localhost:3306
# Create the database first: CREATE DATABASE cp_club;
DATABASE_URL="mysql://root:@localhost:3306/cp_club"
# If you set a MySQL password: DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/cp_club"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV="development"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Your frontend URL (no trailing slash)
FRONTEND_URL="http://localhost:3000"

# ── Storage (for future dynamic file uploads) ─────────────────────────────────
# "local" = save uploads to backend/uploads/ (default for development)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
REGISTRATION_RATE_LIMIT_MAX=5

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL="info"

# ── First SUPER_ADMIN setup (used by db:seed) ─────────────────────────────────
SEED_ADMIN_EMAIL="admin@cpclub.mu.ac.in"
SEED_ADMIN_PASSWORD="ChangeMe@2024!"
SEED_ADMIN_NAME="CP Club Admin"
